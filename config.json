{
  "paths": {
    "albums": "./music-source",
    "runtime": "./runtime"
  },
  "profile": {
    "width": 1280, "height": 720, "fps": 24,
    "videoBitrate": "2500k", "audioBitrate": "160k",
    "preset": "veryfast"
  },
  "queue": { "mode": "shuffle", "batchSize": 50 },
  "overlay": {
    "enabled": true,
    "fontFile": "C:/Windows/Fonts/YuGothR.ttc",
    "fontSize": 28,
    "position": "bottom-left"
  },
  "output": {
    "mode": "rtmp",
    "localPath": "./runtime/out.flv"
  }
}
