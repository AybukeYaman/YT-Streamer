# YouTube Data API v3 kimlik bilgileri — KANAL seviyesi, yayın instance'ı seviyesi DEGIL.
#
# Kopyala:  cp .env.youtube.example .env.youtube  &&  chmod 600 .env.youtube
#
# Neden .env / .env.<isim>'den ayri: OAuth kimligi kanala ait, her yayina ayri kopya
# tutmak anlamsiz. Ayrica scripts/deploy/check-env.sh, .env.example'i sozlesme kabul
# edip oradaki HER key'i zorunlu sayiyor — bu key'ler oraya konsa dosyalar doldurulana
# kadar deploy DURURDU ve her .env.<isim> instance'i "eksik env" diye atlanirdi.
# Ayrinti: KARARLAR.md
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Bir kerelik alinir (tarayicisi olan makinede, VPS'te degil):
#   node scripts/youtube/get-refresh-token.js            # bilgisayardan izin
#   node scripts/youtube/get-refresh-token.js --manual   # telefondan izin
# Sonra bu satira yaz ve dogrula:  node scripts/youtube/verify-access.js
#
# ONEMLI: OAuth consent screen "Testing" modundaysa refresh token 7 GUNDE expire olur.
# 7/24 yayin icin Google Cloud Console -> OAuth consent screen -> "In production".
YOUTUBE_REFRESH_TOKEN=

# go-live HTTP servisinin (yt-golive.service) bearer token'i. ZORUNLU: token bos ya da
# 32 karakterden kisa ise servis baslamayi REDDEDER (canli yayin baslatabilen bir
# endpoint'in auth'suz ayaga kalkmasi sessiz bir guvenlik acigi olurdu).
#   Uret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOLIVE_AUTH_TOKEN=

# go-live servisinin dinledigi port (varsayilan 8787). Yalnizca 127.0.0.1'e bind eder;
# iOS erisimi `tailscale serve` ile saglanir (bkz. scripts/deploy/README.md).
GOLIVE_PORT=8787
